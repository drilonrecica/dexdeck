class Dexdeck < Formula
  desc "Fast, private terminal control plane for Android development"
  homepage "https://github.com/drilonrecica/dexdeck"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/drilonrecica/dexdeck/releases/download/v@VERSION@/dexdeck-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    else
      url "https://github.com/drilonrecica/dexdeck/releases/download/v@VERSION@/dexdeck-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/drilonrecica/dexdeck/releases/download/v@VERSION@/dexdeck-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_GNU@"
    else
      url "https://github.com/drilonrecica/dexdeck/releases/download/v@VERSION@/dexdeck-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "dexdeck"
    man1.install "man/man1/dexdeck.1"
    bash_completion.install "completions/dexdeck.bash" => "dexdeck"
    zsh_completion.install "completions/_dexdeck"
    fish_completion.install "completions/dexdeck.fish"
  end

  test do
    assert_match "DexDeck #{version}", shell_output("#{bin}/dexdeck version")
  end
end
